{
  "name": "pi-agent-hypite",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "saas:dev": "node apps/saas-api/server.mjs",
    "saas:build": "node scripts/build-saas-web.mjs",
    "workers:p0:build": "npm --prefix experiments/workers-p0 run build",
    "workers:p0:build:minimal": "npm --prefix experiments/workers-p0 run build:minimal",
    "workers:p0:matrix": "npm --prefix experiments/workers-p0 run matrix",
    "workers:p0:test": "npm --prefix experiments/workers-p0 test",
    "workers:p0:bench": "npm --prefix experiments/workers-p0 run bench --",
    "workers:storage:test": "node scripts/verify-worker-storage.mjs",
    "workers:execution:test": "node experiments/workers-p0/scripts/execution-check.mjs",
    "verify:session": "node scripts/verify-worker-session.mjs",
    "migrate:d1": "node scripts/migrate-to-d1.mjs",
    "verify:migration": "node scripts/verify-migration.mjs",
    "verify:worker-api": "node scripts/verify-worker-api.mjs",
    "cf:login": "node experiments/workers-p0/node_modules/wrangler/bin/wrangler.js login",
    "cf:whoami": "node experiments/workers-p0/node_modules/wrangler/bin/wrangler.js whoami",
    "cf:d1:create": "node experiments/workers-p0/node_modules/wrangler/bin/wrangler.js d1 create pi-studio",
    "cf:d1:schema": "node experiments/workers-p0/node_modules/wrangler/bin/wrangler.js d1 execute pi-studio --remote --file=packages/cloudflare-storage/schema.sql -c apps/saas-worker/wrangler.jsonc",
    "cf:d1:list": "node experiments/workers-p0/node_modules/wrangler/bin/wrangler.js d1 list",
    "cf:deploy": "node experiments/workers-p0/node_modules/wrangler/bin/wrangler.js deploy -c apps/saas-worker/wrangler.jsonc",
    "cf:tail": "node experiments/workers-p0/node_modules/wrangler/bin/wrangler.js tail -c apps/saas-worker/wrangler.jsonc",
    "verify:r2": "node scripts/verify-r2-upload.mjs",
    "remix-a:inventory": "node experiments/remix-a/inventory.mjs",
    "start": "node apps/api/server.mjs",
    "doctor": "node scripts/doctor.mjs",
    "job": "node scripts/job.mjs",
    "test": "node --test test/*.test.mjs",
    "verify:integration": "node scripts/verify-integration.mjs",
    "pi": "node scripts/pi.mjs",
    "source:setup": "node scripts/source.mjs setup",
    "source:build": "node scripts/source.mjs build",
    "source:models": "node scripts/source.mjs models",
    "hypit": "node scripts/source.mjs hypit",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:check": "node scripts/desktop.mjs check",
    "desktop:smoke": "node scripts/desktop.mjs smoke",
    "desktop:test": "node scripts/desktop.mjs test",
    "desktop:qa": "node scripts/desktop.mjs qa"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
