{
  // Production Workers configuration for the SaaS API + static frontend.
  //
  // Before the first deploy:
  //   1. npm run saas:build            (fills ../../dist/saas-web, which `assets` serves)
  //   2. wrangler d1 create pi-studio  (paste the returned database_id below)
  //   3. wrangler d1 execute pi-studio --remote --file=<packages/cloudflare-storage/schema.sql>
  //   4. wrangler r2 bucket create pi-media   (or reuse an existing bucket)
  //   5. wrangler secret put S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
  //      The R2 token must be scoped to this bucket only, with Object Read & Write.
  //
  // S3_ENDPOINT and S3_BUCKET are configuration, not secrets, so they live in vars.
  "$schema": "../../experiments/workers-p0/node_modules/wrangler/config-schema.json",
  "name": "pi-studio-saas",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "observability": { "enabled": true },
  "assets": {
    "directory": "../../dist/saas-web",
    "binding": "ASSETS"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "pi-studio", "database_id": "REPLACE_WITH_WRANGLER_D1_CREATE_OUTPUT" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "pi-media" }
  ],
  "vars": {
    "S3_ENDPOINT": "https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com",
    "S3_BUCKET": "pi-media"
  }
}
