{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Hypit Workspace",
  "version": "0.0.1",
  "identifier": "com.pi-hypit.workspace",
  "build": { "frontendDist": "../../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Pi × Hypit · 开发原型", "width": 1280, "height": 860, "minWidth": 760, "minHeight": 560, "dataDirectory": "G:/DevCache/Temp/pi-agent-hypite/desktop/webview" }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; object-src 'none'; base-uri 'none'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
